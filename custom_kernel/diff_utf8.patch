+    or eax, 0b11
+    mov [boot_pdpt], eax
+
+    mov eax, boot_pd1
+    or eax, 0b11
+    mov [boot_pdpt + 1 * 8], eax
+
+    mov eax, boot_pd2
+    or eax, 0b11
+    mov [boot_pdpt + 2 * 8], eax
+
+    mov eax, boot_pd3
+    or eax, 0b11
+    mov [boot_pdpt + 3 * 8], eax
+
+    ; ---- PDPT[510] → PD_high (higher-half: 0xFFFFFFFF80000000) ----
